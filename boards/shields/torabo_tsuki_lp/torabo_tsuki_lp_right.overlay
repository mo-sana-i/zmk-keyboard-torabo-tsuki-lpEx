#define TORABO_TSUKI_LP_RIGHT 1

#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&pointing_listener {
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
    scroller {
        layers = <3>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT)
            &zip_xy_to_scroll_mapper
        >;
    };
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};

/ {
    /* 1. 物理的なLEDのピン定義（赤・黄に加えて、緑を追加） */
    leds {
        compatible = "gpio-leds";
        
        ext_led_red: led_0 {
            gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
            label = "Red LED";
        };

        ext_led_yellow: led_1 {
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
            label = "Yellow LED";
        };

        ext_led_green: led_2 {
            gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
            label = "Green LED";
        };
    };

    /* 2. レイヤー連動の設定（レイヤー1, 2, 3の定義） */
    layer_leds {
        compatible = "zmk,behavior-layer-led";

        /* レイヤー1のときに黄色LEDを点灯 */
        layer1_led {
            layers = <1>;
            leds = <&ext_led_yellow>;
        };

        /* レイヤー2のときに緑色LEDを点灯 */
        layer2_led {
            layers = <2>;
            leds = <&ext_led_green>;
        };

        /* レイヤー3のときに赤色LEDを点灯 */
        layer3_led {
            layers = <3>;
            leds = <&ext_led_red>;
        };
    };
};

/* --- 以下、今回の右手ビルドエラー回避用のダミー追加分（完全修正版） --- */
/ {
    /* keymap.keymap から呼ばれる「存在しないハードウェア」の怒られ回避用ダミー定義 */
    /* 左手と同じ sekigon,hires-dial を名乗ることでリンクエラーを防ぎ、status="disabled"で無効化します */
    dummy_hardware {
        hires_dial_ext: hires_dial_ext {
            compatible = "sekigon,hires-dial";
            status = "disabled";
            res-cpi = <1275>;
            counts-per-revolution = <1275>;
            motion-gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    /* 右手側にはセンサーが物理的に存在しないため上記のダミーを割り当て */
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&hires_dial_ext>;
        triggers-per-rotation = <20>;
    };
};
