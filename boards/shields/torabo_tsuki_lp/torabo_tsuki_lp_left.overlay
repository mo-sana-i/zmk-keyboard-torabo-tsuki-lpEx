#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&pointing_listener {
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
};

/ {
    /* 1. 物理的なLEDのピン定義（赤・黄に加えて、緑を追加） */
    leds {
        compatible = "gpio-leds";
        
        ext_led_red: led_0 {
            gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
            label = "Red LED";
        };

        ext_led_yellow: led_1 {
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
            label = "Yellow LED";
        };

        ext_led_green: led_2 {
            gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
            label = "Green LED";
        };
    };

    /* 2. レイヤー連動の設定（レイヤー1, 2, 3の定義） */
    layer_leds {
        compatible = "zmk,behavior-layer-led";

        /* レイヤー1のときに黄色LEDを点灯 */
        layer1_led {
            layers = <1>;
            leds = <&ext_led_yellow>;
        };

        /* レイヤー2のときに緑色LEDを点灯 */
        layer2_led {
            layers = <2>;
            leds = <&ext_led_green>;
        };

        /* レイヤー3のときに赤色LEDを点灯 */
        layer3_led {
            layers = <3>;
            leds = <&ext_led_red>;
        };

        /* レイヤー0のときは、ここに記述がないため自動的にすべて消灯します */
    };
};

